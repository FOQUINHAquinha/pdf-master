<UserControl x:Class="PDFMaster.App.Views.WatermarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adicionar PDFs…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Aplicar marca d&apos;água" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding StartCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap" Margin="2,10,0,0"
                   Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Texto" IsChecked="{Binding UseText, Mode=OneWay}" Checked="OnUseText" GroupName="WmKind" />
                        <RadioButton Content="Imagem" Margin="18,0,0,0" IsChecked="{Binding UseImage, Mode=TwoWay}" GroupName="WmKind" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding UseText, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Texto" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Fonte, tamanho e cor" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="150" ItemsSource="{Binding Families}" SelectedItem="{Binding FontFamily, Mode=TwoWay}" />
                            <TextBox Width="50" Margin="6,0,0,0" Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Width="84" Margin="6,0,0,0" Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" ToolTip="#RRGGBB" />
                            <Border Width="22" Height="22" CornerRadius="11" Margin="6,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                            <CheckBox Content="Negrito" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Bold, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding UseImage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Imagem (PNG com transparência é o ideal)" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding PickImageCommand}" />
                            <TextBox IsReadOnly="True" Text="{Binding ImagePath, Mode=OneWay}" />
                        </DockPanel>
                        <TextBlock Text="Largura (% da página)" Style="{StaticResource Label}" />
                        <Slider Minimum="5" Maximum="100" Value="{Binding ImageWidth, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Posição" Style="{StaticResource Label}" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Positions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPosition, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Opacity, StringFormat='Opacidade: {0:0}%'}" Style="{StaticResource Label}" />
                    <Slider Minimum="5" Maximum="100" Value="{Binding Opacity, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Rotation, StringFormat='Rotação: {0:0}°'}" Style="{StaticResource Label}" />
                    <Slider Minimum="-90" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Rotation, Mode=TwoWay}" />
                    <TextBlock Text="Páginas (vazio = todas; ex.: 1-3,5)" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Pages, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Por baixo do conteúdo (não aparece sob imagens e áreas opacas)" Margin="0,8,0,0" IsChecked="{Binding Behind, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista de documentos -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,8" MinHeight="90">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste para cá os PDFs" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Vários documentos são processados em fila. Os originais não são alterados."
                               Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Files}" Template="{StaticResource ScrollingItems}" ItemsPanel="{StaticResource VirtualPanel}"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12" ToolTip="Mover para cima" Command="{Binding MoveUpCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12" ToolTip="Mover para baixo" Command="{Binding MoveDownCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Remover da lista (o arquivo não é apagado)" Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusLine" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}"
                                                   Visibility="{Binding Status, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
