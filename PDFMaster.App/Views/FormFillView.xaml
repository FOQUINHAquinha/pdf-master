<UserControl x:Class="PDFMaster.App.Views.FormFillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DocumentName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="340" Foreground="{DynamicResource Brush.Text}" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Abrir formulário…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFileCommand}" />
            <Button Content="Criar campos no editor" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding CreateFieldsCommand}"
                    ToolTip="Abre este documento no editor com as ferramentas de formulário" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Gravar preenchido" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding SaveCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="2,10,0,0" />

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,8">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste um formulário PDF para cá" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Fields}" Template="{StaticResource ScrollingItems}" ItemsPanel="{StaticResource VirtualPanel}"
                              Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="{Binding Info.Multiline}" TextWrapping="Wrap" MaxHeight="120"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                        <CheckBox Content="Marcado" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Visibility="{Binding IsCheck, Converter={StaticResource BoolToVis}}" />
                                        <ComboBox ItemsSource="{Binding Info.Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="200"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding LockedValue}" Style="{StaticResource Secondary}"
                                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
