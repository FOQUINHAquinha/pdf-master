<UserControl x:Class="PDFMaster.App.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

        <!-- Barra de ações -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adicionar arquivos…" Style="{StaticResource PrimaryButton}"
                    Command="{Binding PickFilesCommand}" />
            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Command="{Binding ClearCommand}" />
        </StackPanel>

        <!-- Rodapé: saída e execução -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Width="220" Margin="0,0,12,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsImageToPdf}" Value="True" />
                                        <Condition Binding="{Binding IsSinglePdf}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Nome do PDF" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A extensão .pdf é adicionada automaticamente" />
                </StackPanel>
                <ContentPresenter Grid.Column="1" Content="{Binding}"
                                  ContentTemplate="{StaticResource ToolOutputFolder}" />
                <Button Grid.Column="3" Content="{Binding RunLabel}" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" VerticalAlignment="Bottom" Command="{Binding StartCommand}" />
            </Grid>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />

        <!-- Resumo ou problema -->
        <Grid DockPanel.Dock="Bottom" Margin="2,10,0,0">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Danger}"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />
        </Grid>

        <!-- Opções -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
                <!-- PDF para imagem -->
                <StackPanel Visibility="{Binding IsPdfToImage, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="Formato" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                            <ComboBox Width="300" ItemsSource="{Binding ImageFormats}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedImageFormat, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="Resolução (DPI)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                            <TextBox Width="90" Text="{Binding DpiText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="72 = tamanho de tela · 150 = boa leitura · 300 = impressão" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6"
                                    Visibility="{Binding IsJpegSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Qualidade JPG (1–100)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                            <TextBox Width="90" Text="{Binding QualityText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="Páginas (vazio = todas)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                            <TextBox Width="170" Text="{Binding PagesText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Exemplos: 1-5 · 1,3,5,7 · 2-8,12,15-20" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="Escala de cinza" IsChecked="{Binding Grayscale, Mode=TwoWay}" />
                        <CheckBox Content="Um único arquivo TIFF com todas as páginas" Margin="24,0,0,0"
                                  IsChecked="{Binding SingleTiff, Mode=TwoWay}"
                                  Visibility="{Binding IsTiffSelected, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Imagem para PDF -->
                <StackPanel Visibility="{Binding IsImageToPdf, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="Tamanho da página" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                            <ComboBox Width="230" ItemsSource="{Binding PageSizes}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6"
                                    Visibility="{Binding IsFixedPageSize, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Orientação" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                            <ComboBox Width="250" ItemsSource="{Binding Orientations}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedOrientation, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="Margem (mm)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                            <TextBox Width="90" Text="{Binding MarginText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6"
                                    Visibility="{Binding UseJpeg, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Qualidade JPG (1–100)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                            <TextBox Width="90" Text="{Binding QualityText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="Um PDF para cada imagem" IsChecked="{Binding OnePdfPerImage, Mode=TwoWay}" />
                        <CheckBox Content="Gravar em JPEG as imagens que não são JPG (menor, com perda)" Margin="24,0,0,0"
                                  IsChecked="{Binding UseJpeg, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <!-- Texto e HTML para PDF -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsTextHtmlToPdf, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="Fonte de largura fixa nos arquivos TXT" IsChecked="{Binding Monospace, Mode=TwoWay}"
                              ToolTip="Mantém o alinhamento de colunas do texto" />
                    <CheckBox Content="Página em paisagem (TXT)" Margin="24,0,0,0"
                              IsChecked="{Binding Landscape, Mode=TwoWay}" />
                </StackPanel>

                <!-- PDF para Word -->
                <CheckBox Content="Tentar manter a aparência do original (usa o LibreOffice)"
                          IsChecked="{Binding KeepLayout, Mode=TwoWay}"
                          Visibility="{Binding IsPdfToWord, Converter={StaticResource BoolToVis}}" />

                <!-- PDF para texto -->
                <StackPanel HorizontalAlignment="Left"
                            Visibility="{Binding IsPdfToText, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Formato" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <ComboBox Width="260" ItemsSource="{Binding TextFormats}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedTextFormat, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Text="{Binding LibreOfficeStatus}" Style="{StaticResource Secondary}" Margin="0,8,0,0"
                           Visibility="{Binding ShowsLibreOffice, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Limitations}" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Lista de arquivos -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,8" MinHeight="90">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="26"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="{Binding DropHint}" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Os arquivos originais não são alterados." Style="{StaticResource Secondary}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Files}" Template="{StaticResource ScrollingItems}"
                              ItemsPanel="{StaticResource VirtualPanel}"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12"
                                                ToolTip="Mover para cima" Command="{Binding MoveUpCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12"
                                                ToolTip="Mover para baixo" Command="{Binding MoveDownCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                                                ToolTip="Remover da lista (o arquivo não é apagado)"
                                                Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource Icon}"
                                               FontSize="18" Margin="0,0,12,0"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusLine" Text="{Binding Status}" FontSize="12"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}"
                                                   Visibility="{Binding Status, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                    <Setter TargetName="StatusLine" Property="Foreground"
                                            Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
