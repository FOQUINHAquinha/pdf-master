<UserControl x:Class="PDFMaster.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" FontSize="13.5"
                       Text="As alterações são salvas automaticamente neste computador." />

            <!-- Aparência -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Geral — aparência" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Tema" Style="{StaticResource Body}" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Claro" GroupName="Theme" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        <RadioButton Content="Escuro" GroupName="Theme" Margin="18,0,0,0"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock Text="Cor de destaque" Style="{StaticResource Body}" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding Swatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectCommand}" ToolTip="{Binding Hex}" Margin="0,0,8,0"
                                        Cursor="Hand" Width="30" Height="30" Background="{Binding Hex}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="15" Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource Brush.Text}" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Width="130" Text="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Código da cor no formato #RRGGBB" MaxLength="7" />
                        <Button Content="Aplicar cor" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding ApplyAccentCommand}" />
                        <Button Content="Usar cor padrão" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding ResetAccentCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AccentStatus}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Arquivos -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Arquivos" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Pasta padrão para os resultados" Style="{StaticResource Body}" Margin="0,12,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remover" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding ClearDefaultFolderCommand}"
                                Visibility="{Binding HasDefaultFolder, Converter={StaticResource BoolToVis}}" />
                        <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding BrowseDefaultFolderCommand}" />
                        <Border Background="{DynamicResource Brush.Subtle}" CornerRadius="6" Padding="10,7">
                            <Grid>
                                <TextBlock Text="{Binding DefaultFolder}" Style="{StaticResource Body}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Nenhuma — o programa pergunta a cada operação."
                                           Style="{StaticResource Secondary}"
                                           Visibility="{Binding HasDefaultFolder, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                    </DockPanel>
                    <CheckBox Content="Lembrar a última pasta utilizada" Margin="0,12,0,0"
                              IsChecked="{Binding RememberLastFolder, Mode=TwoWay}" />

                    <TextBlock Text="Quando o arquivo de saída já existir" Style="{StaticResource Body}"
                               Margin="0,16,0,4" />
                    <ComboBox HorizontalAlignment="Left" MinWidth="420" ItemsSource="{Binding OverwritePolicies}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedOverwritePolicy, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                               Text="Os arquivos originais nunca são alterados. A substituição só acontece se você escolher essa opção e confirmar na hora." />

                    <TextBlock Text="Organização dos resultados" Style="{StaticResource Body}" Margin="0,16,0,4" />
                    <ComboBox HorizontalAlignment="Left" MinWidth="420" ItemsSource="{Binding SubfolderModes}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedSubfolderMode, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Padrões das ferramentas e desempenho -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Padrões e desempenho" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Perfil de compressão ao abrir &quot;Comprimir PDF&quot;" Style="{StaticResource Body}" Margin="0,12,0,4" />
                    <ComboBox HorizontalAlignment="Left" MinWidth="420" ItemsSource="{Binding CompressionProfiles}"
                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedCompressionProfile, Mode=TwoWay}" />

                    <TextBlock Text="OCR: idiomas marcados e resolução ao abrir a ferramenta" Style="{StaticResource Body}" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="160" Text="{Binding OcrLanguagesText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Códigos do Tesseract separados por +, ex.: por+eng" />
                        <TextBox Width="70" Margin="8,0,0,0" Text="{Binding OcrDpiText, UpdateSourceTrigger=PropertyChanged}" ToolTip="DPI (100 a 600)" />
                        <TextBlock Text="DPI" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <Button Content="Salvar padrões do OCR" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                Command="{Binding ApplyOcrDefaultsCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DefaultsStatus}" Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="Fila de tarefas: quantos documentos processar ao mesmo tempo" Style="{StaticResource Body}" Margin="0,16,0,4" />
                    <ComboBox HorizontalAlignment="Left" MinWidth="420" ItemsSource="{Binding ParallelChoices}"
                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedParallel, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Mais tarefas simultâneas terminam lotes grandes mais cedo, mas usam mais memória; OCR e PDF/A são as etapas mais pesadas." />
                </StackPanel>
            </Border>

            <!-- Integração com o Windows -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Integração com o Windows" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Alterações feitas apenas para o seu usuário (sem permissão de administrador). Podem ser desfeitas aqui a qualquer momento." />
                    <CheckBox Content="Itens do PDF Master no menu de contexto dos PDFs (Mesclar, Comprimir, Converter para imagem, Extrair páginas, Proteger, Abrir)"
                              Margin="0,12,0,0" IsChecked="{Binding ContextMenuInstalled, Mode=TwoWay}" />
                    <CheckBox Content="Mostrar o PDF Master em &quot;Abrir com&quot; para arquivos PDF" Margin="0,8,0,0"
                              IsChecked="{Binding OpenWithRegistered, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Escolher o programa padrão para PDF…" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenDefaultAppsCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="O Windows não permite que um programa se torne o padrão sozinho: a escolha é feita por você na tela de aplicativos padrão." />
                    <TextBlock Text="{Binding WindowsStatus}" Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Privacidade -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Privacidade" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                               Text="O PDF Master não usa a rede: não envia documentos, não coleta telemetria e não procura atualizações por conta própria." />

                    <CheckBox Content="Registrar histórico de operações e arquivos recentes" Margin="0,12,0,0"
                              IsChecked="{Binding HistoryEnabled, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Limpar histórico" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearHistoryCommand}" />
                        <Button Content="Limpar arquivos recentes" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding ClearRecentCommand}" />
                    </StackPanel>

                    <TextBlock Text="Dados e diagnósticos locais" Style="{StaticResource Body}" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource Secondary}">
                        <Run Text="Configurações e histórico: " />
                        <Run Text="{Binding DataDirectory, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                               Text="Modo portátil ativo: os dados ficam ao lado do executável."
                               Visibility="{Binding IsPortable, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Abrir pasta de diagnósticos" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogsCommand}" />
                        <Button Content="Limpar arquivos temporários" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding CleanTempCommand}"
                                ToolTip="Apaga sobras de operações interrompidas (pasta PDFMaster dentro dos temporários do Windows). Seus documentos não são tocados." />
                    </StackPanel>
                    <TextBlock Text="{Binding TempStatus}" Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Temporários com mais de um dia são apagados automaticamente ao abrir o programa." />
                </StackPanel>
            </Border>

            <!-- Sobre -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Sobre" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding AboutTitle}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding AuthorText}" Style="{StaticResource Body}" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Componentes de terceiros: PDFsharp (MIT), PDFium (BSD-3-Clause/Apache-2.0), PdfPig (Apache-2.0), Tesseract e modelos tessdata (Apache-2.0), SQLite (domínio público), CommunityToolkit.Mvvm e bibliotecas .NET (MIT), Serilog (Apache-2.0). O LibreOffice (MPL-2.0) é usado somente se estiver instalado no computador." />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="A compressão de vídeo usa o FFmpeg (ffmpeg.org) na variante LGPL 2.1, compilado por BtbN/FFmpeg-Builds e executado como programa separado. A licença acompanha o executável extraído na pasta de dados (video-runtime); o código-fonte está disponível em ffmpeg.org e github.com/BtbN/FFmpeg-Builds." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
