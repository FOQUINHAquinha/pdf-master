<UserControl x:Class="PDFMaster.App.Views.ExtractContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adicionar PDFs…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="O que extrair" Style="{StaticResource SectionTitle}" />
                <WrapPanel Margin="0,10,0,0">
                    <CheckBox Content="Imagens (JPEG como estão; as demais em PNG)" Margin="0,0,24,6" IsChecked="{Binding Images, Mode=TwoWay}" />
                    <CheckBox Content="Texto (texto.txt, página a página)" Margin="0,0,24,6" IsChecked="{Binding Text, Mode=TwoWay}" />
                    <CheckBox Content="Anexos" Margin="0,0,24,6" IsChecked="{Binding Attachments, Mode=TwoWay}" />
                    <CheckBox Content="Fontes incorporadas" Margin="0,0,24,6" IsChecked="{Binding Fonts, Mode=TwoWay}" />
                    <CheckBox Content="Metadados (propriedades e XMP)" Margin="0,0,24,6" IsChecked="{Binding Metadata, Mode=TwoWay}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Imagens repetidas em várias páginas são gravadas uma vez. Transparências (máscaras) das imagens não são incluídas no PNG. Documentos digitalizados não têm texto: use o OCR antes." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Extrair" Style="{StaticResource PrimaryButton}" MinWidth="140"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding ExtractCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0" MaxHeight="180"
                Visibility="{Binding Result, Converter={StaticResource NullToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Result}" Style="{StaticResource Body}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <ContentPresenter Margin="0,12,0,0" Content="{Binding}" ContentTemplate="{StaticResource ToolFileList}" />
    </DockPanel>
</UserControl>
