<UserControl x:Class="PDFMaster.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Página renderizada com os destaques por cima (coordenadas em pontos da página) -->
        <DataTemplate x:Key="Overlay">
            <Border Width="{Binding Width}" Height="{Binding Height}" BorderThickness="{Binding Thickness}"
                    BorderBrush="{Binding Stroke, Converter={StaticResource HexToBrush}}"
                    Background="{Binding Fill, Converter={StaticResource HexToBrush}}" />
        </DataTemplate>
        <Style x:Key="OverlayItem" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <ItemsPanelTemplate x:Key="CanvasPanel">
            <Canvas />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Primeiro PDF…" Style="{StaticResource SecondaryButton}" Command="{Binding PickACommand}" />
                        <TextBlock Text="{Binding NameA}" ToolTip="{Binding PathA}" Style="{StaticResource Body}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </DockPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8AB;" Margin="12,0" ToolTip="Trocar os lados"
                            Command="{Binding SwapCommand}" />
                    <DockPanel Grid.Column="2">
                        <Button DockPanel.Dock="Left" Content="Segundo PDF…" Style="{StaticResource SecondaryButton}" Command="{Binding PickBCommand}" />
                        <TextBlock Text="{Binding NameB}" ToolTip="{Binding PathB}" Style="{StaticResource Body}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </DockPanel>
                </Grid>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Comparar" Style="{StaticResource PrimaryButton}" MinWidth="130" Command="{Binding CompareCommand}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Texto" IsChecked="{Binding CompareText, Mode=TwoWay}" />
                        <CheckBox Content="Aparência (pixels)" Margin="16,0,0,0" IsChecked="{Binding CompareVisual, Mode=TwoWay}" />
                        <CheckBox Content="Imagens" Margin="16,0,0,0" IsChecked="{Binding CompareImages, Mode=TwoWay}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Gerar relatório (HTML)" Style="{StaticResource PrimaryButton}" MinWidth="170"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding SaveReportCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>

        <!-- Lista de diferenças -->
        <Border DockPanel.Dock="Right" Width="330" Style="{StaticResource Card}" Margin="12,12,0,0" Padding="12"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Diferenças" Style="{StaticResource SectionTitle}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Secondary}" Margin="0,4,0,8" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Anterior" Style="{StaticResource ToolbarButton}" Command="{Binding PreviousChangeCommand}" />
                    <Button Content="Próxima" Style="{StaticResource ToolbarButton}" Command="{Binding NextChangeCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange, Mode=TwoWay}" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,4,8,0" VerticalAlignment="Top"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Secondary}" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Margin="0,12,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="Escolha (ou arraste) os dois PDFs e clique em Comparar" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="Vermelho: removido · verde: acrescentado · amarelo: alterado · azul: imagem ou aparência"
                           Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
            <DockPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Página anterior" Style="{StaticResource ToolbarButton}" Command="{Binding PreviousPageCommand}" />
                        <TextBlock Text="{Binding PairText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="10,0,16,6" />
                        <Button Content="Próxima página" Style="{StaticResource ToolbarButton}" Command="{Binding NextPageCommand}" />
                    </StackPanel>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding LeftCaption}" Style="{StaticResource Secondary}" Margin="0,0,0,6" />
                        <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                            <Grid Width="{Binding LeftWidth}" Height="{Binding LeftHeight}">
                                <Border Style="{StaticResource PageFrame}" />
                                <Image Source="{Binding LeftImage}" Stretch="Fill" />
                                <ItemsControl ItemsSource="{Binding LeftBoxes}" ItemsPanel="{StaticResource CanvasPanel}"
                                              ItemTemplate="{StaticResource Overlay}" ItemContainerStyle="{StaticResource OverlayItem}" />
                            </Grid>
                        </Viewbox>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RightCaption}" Style="{StaticResource Secondary}" Margin="0,0,0,6" />
                        <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                            <Grid Width="{Binding RightWidth}" Height="{Binding RightHeight}">
                                <Border Style="{StaticResource PageFrame}" />
                                <Image Source="{Binding RightImage}" Stretch="Fill" />
                                <ItemsControl ItemsSource="{Binding RightBoxes}" ItemsPanel="{StaticResource CanvasPanel}"
                                              ItemTemplate="{StaticResource Overlay}" ItemContainerStyle="{StaticResource OverlayItem}" />
                            </Grid>
                        </Viewbox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
