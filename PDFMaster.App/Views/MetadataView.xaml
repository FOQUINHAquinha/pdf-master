<UserControl x:Class="PDFMaster.App.Views.MetadataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Abrir PDF…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
        </StackPanel>
        <ContentPresenter DockPanel.Dock="Top" Margin="0,12,0,0" MaxHeight="120" Content="{Binding}" ContentTemplate="{StaticResource ToolFileList}" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button Content="Remover todos os metadados" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveAllCommand}" />
                    <Button Content="Salvar cópia" Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
                </StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap" Margin="2,10,0,0"
                   Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12" IsEnabled="{Binding Loaded}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Título" Style="{StaticResource Label}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding DocTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Autor" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Assunto" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Palavras-chave" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Criador (programa que criou o original)" Style="{StaticResource Label}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Creator, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Produtor (programa que gerou o PDF)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Producer, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Data de criação (dd/mm/aaaa hh:mm:ss; vazio = sem data)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Created, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Data de modificação" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Modified, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UpdateModified, Converter={StaticResource InverseBool}}" />
                        <CheckBox Content="Usar a data e hora atuais" Margin="0,6,0,0" IsChecked="{Binding UpdateModified, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Extra}" Style="{StaticResource Secondary}" Margin="0,14,0,0"
                               VerticalAlignment="Bottom" Visibility="{Binding Extra, Converter={StaticResource NullToVis}}" />
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
