<UserControl x:Class="PDFMaster.App.Views.CombineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

        <!-- Barra de ações -->
        <DockPanel DockPanel.Dock="Top" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Mesclar em sequência" GroupName="CombineMode"
                             IsChecked="{Binding IsMerge, Mode=TwoWay}" />
                <RadioButton Content="Intercalar páginas" GroupName="CombineMode" Margin="16,0,0,0"
                             IsChecked="{Binding IsInterleave, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Adicionar arquivos…" Style="{StaticResource PrimaryButton}"
                        Command="{Binding PickFilesCommand}" />
                <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Rodapé: saída e execução -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Nome do arquivo final" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A extensão .pdf é adicionada automaticamente" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}"
                                  ContentTemplate="{StaticResource ToolOutputFolder}" />
                <Button Grid.Column="4" Content="{Binding RunLabel}" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" VerticalAlignment="Bottom" Command="{Binding StartCommand}" />
            </Grid>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />

        <!-- Resumo ou problema -->
        <Grid DockPanel.Dock="Bottom" Margin="2,10,0,0">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Danger}"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />
        </Grid>

        <!-- Opções do modo -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMerge, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="Criar um marcador para cada arquivo de origem" VerticalAlignment="Center"
                              IsChecked="{Binding BookmarkPerFile, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Páginas das imagens:" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <ComboBox MinWidth="230" Margin="8,0,0,0" ItemsSource="{Binding ImagePageSizes}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedImagePageSize, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsInterleave, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Páginas de cada documento por vez:" Style="{StaticResource Body}"
                               VerticalAlignment="Center" />
                    <TextBox Width="70" Margin="8,0,0,0"
                             Text="{Binding PagesPerTurnText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Parar quando o documento mais curto acabar" Margin="24,0,0,0"
                              VerticalAlignment="Center" IsChecked="{Binding StopAtShortest, Mode=TwoWay}"
                              ToolTip="Desmarcado: as páginas que sobrarem dos documentos mais longos vão para o final" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista de arquivos -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,8">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="28"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste PDFs e fotos para cá ou use “Adicionar arquivos…”" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="A ordem da lista é a ordem do documento final." Style="{StaticResource Secondary}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Files}" Template="{StaticResource ScrollingItems}"
                              ItemsPanel="{StaticResource VirtualPanel}"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PageFrame}" Width="42" Height="56"
                                            HorizontalAlignment="Left">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" />
                                        <TextBlock Text="{Binding RangeError}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.Danger}"
                                                   Visibility="{Binding RangeError, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>

                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding DataContext.IsMerge, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Páginas:" Style="{StaticResource Secondary}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Width="150"
                                                     Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Vazio = todas. Exemplos: 1-5 · 1,3,5,7 · 2-8,12,15-20" />
                                        </StackPanel>
                                        <CheckBox Content="Ordem inversa" IsChecked="{Binding Reverse, Mode=TwoWay}"
                                                  ToolTip="Lê este documento de trás para frente (versos digitalizados ao contrário)"
                                                  Visibility="{Binding DataContext.IsInterleave, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                                    </Grid>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12"
                                                ToolTip="Mover para cima" Command="{Binding MoveUpCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12"
                                                ToolTip="Mover para baixo" Command="{Binding MoveDownCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                                                ToolTip="Remover da lista (o arquivo não é apagado)"
                                                Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
