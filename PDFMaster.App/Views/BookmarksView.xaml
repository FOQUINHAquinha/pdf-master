<UserControl x:Class="PDFMaster.App.Views.BookmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <DockPanel DockPanel.Dock="Top" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="Abrir PDF…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding FirstPath}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Salvar cópia" Style="{StaticResource PrimaryButton}" MinWidth="140"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding SaveCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Problem}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="2,10,0,0"
                   Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Result}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="2,10,0,0"
                   Visibility="{Binding Result, Converter={StaticResource NullToVis}}" />

        <Grid Margin="0,12,0,0">
            <Border Style="{StaticResource Card}" Visibility="{Binding Loaded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolFileList}" />
            </Border>
            <Grid Visibility="{Binding Loaded, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Marcadores -->
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Marcadores" Style="{StaticResource SectionTitle}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding PagesText}" Style="{StaticResource Secondary}" Margin="0,2,0,6" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="Adicionar" Style="{StaticResource ToolbarButton}" Command="{Binding AddBookmarkCommand}" />
                            <Button Content="Remover" Style="{StaticResource ToolbarButton}" Command="{Binding RemoveBookmarkCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Subir" Command="{Binding MoveUpCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Descer" Command="{Binding MoveDownCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Subir um nível" Command="{Binding OutdentCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Tornar subitem do anterior" Command="{Binding IndentCommand}" />
                        </WrapPanel>
                        <CheckBox DockPanel.Dock="Bottom" Margin="0,10,0,0" IsChecked="{Binding TableOfContents, Mode=TwoWay}"
                                  Content="Inserir no início uma página de sumário com estes marcadores (cada linha é um link)" />
                        <ListBox ItemsSource="{Binding Bookmarks}" SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{Binding Indent}">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock Text="pág." Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Width="52" Text="{Binding PageText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Links -->
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Links" Style="{StaticResource SectionTitle}" />
                            <CheckBox DockPanel.Dock="Top" Margin="0,8,0,8" IsChecked="{Binding LinkUrls, Mode=TwoWay}"
                                      Content="Criar links para os endereços escritos no texto (http://, www.)" />
                            <TextBlock DockPanel.Dock="Top" Text="Nenhum link no documento." Style="{StaticResource Secondary}"
                                       Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Links}" Template="{StaticResource ScrollingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <CheckBox DockPanel.Dock="Right" Content="Remover" IsChecked="{Binding Remove, Mode=TwoWay}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding PageText}" Style="{StaticResource Secondary}" Width="70" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Description}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <!-- Anexos -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Content="Anexar arquivos…" Style="{StaticResource ToolbarButton}" Command="{Binding AddAttachmentsCommand}" />
                                <TextBlock Text="Anexos" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Nenhum anexo." Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Attachments}" Template="{StaticResource ScrollingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <CheckBox DockPanel.Dock="Right" Content="Remover" IsChecked="{Binding Remove, Mode=TwoWay}" Margin="8,0,0,0" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Salvar uma cópia do anexo"
                                                    Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
