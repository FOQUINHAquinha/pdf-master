<UserControl x:Class="PDFMaster.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PDFMaster.App.Views"
             Background="Transparent" Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style x:Key="ToolItem" TargetType="ListBoxItem">
            <Setter Property="ToolTip" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="36" Height="34" Margin="0,0,3,3" CornerRadius="6"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,18,24,18">
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding DocumentName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" MaxWidth="320" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding EditSummary}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" />
            </StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        </DockPanel>

        <!-- Barra: documento, páginas, zoom, histórico -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,0">
            <Button Content="Abrir PDF…" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,12,6"
                    Command="{Binding PickFileCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Margin="0,0,0,6"
                    ToolTip="Página anterior (Page Up)" Command="{Binding PreviousPageCommand}" />
            <TextBox Width="48" Margin="4,0,4,6" HorizontalContentAlignment="Center"
                     Text="{Binding PageNumberText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding GoToPageCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="{Binding PageCountText}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,4,6" />
            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Margin="0,0,12,6"
                    ToolTip="Próxima página (Page Down)" Command="{Binding NextPageCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Margin="0,0,0,6" ToolTip="Diminuir zoom"
                    Command="{Binding ZoomOutCommand}" />
            <TextBlock Text="{Binding ZoomText}" Style="{StaticResource Body}" Width="44" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="0,0,0,6" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Margin="0,0,4,6" ToolTip="Aumentar zoom"
                    Command="{Binding ZoomInCommand}" />
            <Button Content="Ajustar à largura" Style="{StaticResource ToolbarButton}" Margin="0,0,12,6"
                    Command="{Binding FitWidthCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Margin="0,0,0,6" ToolTip="Desfazer (Ctrl+Z)"
                    Command="{Binding UndoCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" Margin="0,0,4,6" ToolTip="Refazer (Ctrl+Y)"
                    Command="{Binding RedoCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="0,0,0,6" ToolTip="Excluir item selecionado (Delete)"
                    Command="{Binding DeleteSelectedCommand}" />
        </WrapPanel>

        <!-- Ferramentas -->
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource ToolItem}" Background="Transparent" BorderThickness="0"
                 Margin="0,2,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Rodapé: destino e gravação -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Gravar PDF" Style="{StaticResource PrimaryButton}" MinWidth="130"
                        VerticalAlignment="Bottom" Margin="14,0,0,0" Command="{Binding SaveCommand}"
                        ToolTip="Grava um novo arquivo &quot;nome_editado.pdf&quot; (Ctrl+S). O original não é alterado." />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Notice}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="2,8,0,0" />

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- Miniaturas -->
            <Border Style="{StaticResource Card}" Padding="2">
                <ListBox x:Name="ThumbList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnThumbSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="92" Margin="0,4">
                                <Border Style="{StaticResource PageFrame}" HorizontalAlignment="Center" MinWidth="40" MinHeight="54">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="86" MaxHeight="118" />
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Number}" FontSize="12" Foreground="{DynamicResource Brush.Text}" />
                                    <Border Background="{DynamicResource Brush.Accent}" CornerRadius="7" Padding="5,0" Margin="5,0,0,0"
                                            Visibility="{Binding EditCount, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="{Binding EditCount}" FontSize="10.5" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Página com a camada de edição -->
            <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource Brush.Subtle}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="Arraste um PDF para cá ou use “Abrir PDF…”" Style="{StaticResource Body}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="As alterações são gravadas num novo arquivo; o original não muda." Style="{StaticResource Secondary}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding RenderError}" FontSize="13" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Danger}"
                               Visibility="{Binding RenderError, Converter={StaticResource NullToVis}}" />
                    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Focusable="False" SizeChanged="OnViewportSizeChanged" PreviewMouseWheel="OnPageMouseWheel"
                                  Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                        <Border Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid Width="{Binding PageWidthDip}" Height="{Binding PageHeightDip}">
                                <Image Source="{Binding PageImage}" Stretch="Fill" SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <views:EditorSurface x:Name="Surface" />
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Propriedades -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedKind}" Style="{StaticResource SectionTitle}" />

                        <!-- Texto -->
                        <StackPanel Visibility="{Binding HasItemText, Converter={StaticResource BoolToVis}}">
                            <StackPanel Visibility="{Binding IsReplaceSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Texto original" Style="{StaticResource PanelLabel}" />
                                <TextBlock Text="{Binding OriginalText}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding ItemTextLabel}" Style="{StaticResource PanelLabel}" />
                            <TextBox x:Name="ItemTextBox" Text="{Binding ItemText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="54" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
                            <StackPanel Visibility="{Binding IsReplaceSelected, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Se não der para trocar no próprio PDF, cobrir e escrever por cima" Margin="0,8,0,0"
                                          IsChecked="{Binding AllowOverlay, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Primeiro o programa tenta trocar o texto dentro do PDF, com a mesma fonte. Se a fonte não permitir, o texto antigo é coberto por um retângulo branco — ele continua no arquivo, por baixo, e o layout pode mudar. O resultado de cada troca aparece ao gravar." />
                            </StackPanel>
                        </StackPanel>

                        <!-- Estilo do texto -->
                        <StackPanel Visibility="{Binding HasTextStyle, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Fonte e tamanho" Style="{StaticResource PanelLabel}" />
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="52" Margin="6,0,0,0" Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Tamanho em pontos" />
                                <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding FontFamily, Mode=TwoWay}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ToggleButton Content="N" FontWeight="Bold" Width="30" IsChecked="{Binding IsBold, Mode=TwoWay}" ToolTip="Negrito" />
                                <ToggleButton Content="I" FontStyle="Italic" Width="30" Margin="4,0,0,0" IsChecked="{Binding IsItalic, Mode=TwoWay}" ToolTip="Itálico" />
                                <ToggleButton Width="30" Margin="4,0,8,0" IsChecked="{Binding IsUnderline, Mode=TwoWay}" ToolTip="Sublinhado">
                                    <TextBlock Text="S" TextDecorations="Underline" />
                                </ToggleButton>
                                <ComboBox Width="104" ItemsSource="{Binding Alignments}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedAlignment, Mode=TwoWay}" ToolTip="Alinhamento" />
                            </StackPanel>
                            <TextBlock Text="Espaçamento entre linhas" Style="{StaticResource PanelLabel}" />
                            <Slider Minimum="0.8" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding LineSpacing, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Cor -->
                        <StackPanel Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Cor" Style="{StaticResource PanelLabel}" />
                            <ItemsControl ItemsSource="{Binding Swatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="22" Height="22" Margin="0,0,5,5" Cursor="Hand" ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="11" Background="{Binding Converter={StaticResource HexToBrush}}"
                                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Cor no formato #RRGGBB" />
                        </StackPanel>

                        <!-- Formas -->
                        <StackPanel Visibility="{Binding IsShapeSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Espessura da linha (pt)" Style="{StaticResource PanelLabel}" />
                            <TextBox Width="60" HorizontalAlignment="Left" Text="{Binding StrokeWidthText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Preenchimento (#RRGGBB; vazio = sem preenchimento)" Style="{StaticResource PanelLabel}" TextWrapping="Wrap" />
                            <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding FillHex, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Opacidade (%)" Style="{StaticResource PanelLabel}" />
                            <Slider Minimum="10" Maximum="100" Value="{Binding ShapeOpacity, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Imagem -->
                        <StackPanel Visibility="{Binding IsImageSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Transparência: opacidade (%)" Style="{StaticResource PanelLabel}" />
                            <Slider Minimum="5" Maximum="100" Value="{Binding ImageOpacity, Mode=TwoWay}" />
                            <TextBlock Text="Rotação (graus)" Style="{StaticResource PanelLabel}" />
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="52" Margin="6,0,0,0" Text="{Binding ImageRotation, UpdateSourceTrigger=LostFocus}" />
                                <Slider Minimum="0" Maximum="359" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageRotation, Mode=TwoWay}" />
                            </DockPanel>
                            <TextBlock Text="Recortar (% de cada lado: esquerda, cima, direita, baixo)" Style="{StaticResource PanelLabel}" TextWrapping="Wrap" />
                            <Slider Minimum="0" Maximum="45" Value="{Binding CropLeft, Mode=TwoWay}" ToolTip="Esquerda" />
                            <Slider Minimum="0" Maximum="45" Value="{Binding CropTop, Mode=TwoWay}" ToolTip="Cima" />
                            <Slider Minimum="0" Maximum="45" Value="{Binding CropRight, Mode=TwoWay}" ToolTip="Direita" />
                            <Slider Minimum="0" Maximum="45" Value="{Binding CropBottom, Mode=TwoWay}" ToolTip="Baixo" />
                            <Button Content="Substituir imagem…" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding ReplaceImageCommand}" />
                        </StackPanel>

                        <!-- Campo de formulário -->
                        <StackPanel Visibility="{Binding IsFieldSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nome do campo" Style="{StaticResource PanelLabel}" />
                            <TextBox Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Visibility="{Binding FieldHasOptions, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Opções (uma por linha)" Style="{StaticResource PanelLabel}" />
                                <TextBox Text="{Binding FieldOptions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" />
                            </StackPanel>
                            <TextBlock Text="Valor inicial (botão: texto do botão; caixa de seleção: Sim para marcada)" Style="{StaticResource PanelLabel}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding FieldValue, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Visibility="{Binding FieldIsButton, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Ação do botão" Style="{StaticResource PanelLabel}" />
                                <ComboBox ItemsSource="{Binding ButtonActions}" DisplayMemberPath="Label" SelectedItem="{Binding FieldAction, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Campos de data usam o formato dd/mm/aaaa, conferido pelo leitor de PDF (Adobe Reader e similares). Botões de imprimir dependem do leitor permitir JavaScript." />
                        </StackPanel>

                        <!-- Assinaturas -->
                        <StackPanel Visibility="{Binding IsSignatureTool, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Assinatura visual é só a imagem da assinatura. Não é assinatura digital nem tem validade de certificado ICP-Brasil." />
                            <ListBox ItemsSource="{Binding Signatures}" SelectedItem="{Binding SelectedSignature, Mode=TwoWay}" MaxHeight="190" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" Padding="4" Margin="2">
                                            <Image Source="{Binding Preview}" Height="44" Stretch="Uniform" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Desenhar…" Style="{StaticResource ToolbarButton}" Command="{Binding DrawSignatureCommand}" />
                                <Button Content="Importar…" Style="{StaticResource ToolbarButton}" Command="{Binding ImportSignatureCommand}" />
                                <Button Content="Excluir" Style="{StaticResource ToolbarButton}" Command="{Binding DeleteSignatureCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Carimbos -->
                        <StackPanel Visibility="{Binding IsStampTool, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Biblioteca de carimbos" Style="{StaticResource PanelLabel}" />
                            <ListBox ItemsSource="{Binding Stamps}" SelectedItem="{Binding SelectedStamp, Mode=TwoWay}" MaxHeight="170">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1.5" CornerRadius="5" Padding="6,1" Margin="1"
                                                BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding Text}" FontWeight="Bold" FontSize="11.5"
                                                       Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Texto" Style="{StaticResource PanelLabel}" />
                            <TextBox Text="{Binding StampText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Cor (#RRGGBB) e linha extra" Style="{StaticResource PanelLabel}" />
                            <DockPanel>
                                <TextBox DockPanel.Dock="Left" Width="84" Margin="0,0,6,0" Text="{Binding StampColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Text="{Binding StampSubtitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex.: setor ou nome (opcional)" />
                            </DockPanel>
                            <CheckBox Content="Mostrar a data" Margin="0,6,0,0" IsChecked="{Binding StampShowDate, Mode=TwoWay}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Novo" Style="{StaticResource ToolbarButton}" Command="{Binding NewStampCommand}" />
                                <Button Content="Salvar modelo" Style="{StaticResource ToolbarButton}" Command="{Binding SaveStampCommand}" />
                                <Button Content="Excluir" Style="{StaticResource ToolbarButton}" Command="{Binding DeleteStampCommand}" />
                                <Button Content="Restaurar exemplos" Style="{StaticResource ToolbarButton}" Command="{Binding RestoreStampsCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <Button Content="Excluir item" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Command="{Binding DeleteSelectedCommand}"
                                Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}" />

                        <!-- Histórico -->
                        <TextBlock Text="Histórico de alterações" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,18,0,4" />
                        <TextBlock Text="Nenhuma alteração ainda." Style="{StaticResource Secondary}"
                                   Visibility="{Binding HistoryEntries.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding HistoryEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
