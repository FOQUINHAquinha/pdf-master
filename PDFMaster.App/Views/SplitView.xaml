<UserControl x:Class="PDFMaster.App.Views.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,22,28,24" MaxWidth="980" HorizontalAlignment="Left">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

            <!-- Documento -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Abrir PDF…" Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center" Command="{Binding PickFileCommand}" />
                    <Grid>
                        <TextBlock Text="Abra o PDF que será dividido, ou arraste o arquivo para cá."
                                   Style="{StaticResource Body}" VerticalAlignment="Center"
                                   Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource PageFrame}" Width="48" Height="64">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,12,0">
                                <TextBlock Text="{Binding DocumentName}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="{Binding DocumentDetails}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Como dividir -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Como dividir" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                    <RadioButton GroupName="SplitMode" Content="Uma página por arquivo"
                                 IsChecked="{Binding IsEveryPage, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton GroupName="SplitMode" Content="A cada" VerticalAlignment="Center"
                                     IsChecked="{Binding IsEveryN, Mode=TwoWay}" />
                        <TextBox Width="64" Margin="8,0,8,0"
                                 Text="{Binding PagesPerFileText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsEveryN}" />
                        <TextBlock Text="páginas" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton GroupName="SplitMode" Content="Por intervalos — um arquivo para cada:"
                                     VerticalAlignment="Center" IsChecked="{Binding IsRanges, Mode=TwoWay}" />
                        <TextBox Width="260" Margin="8,0,0,0"
                                 Text="{Binding RangesText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsRanges}" ToolTip="Exemplo: 1-3,4-10,12 gera três arquivos" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton GroupName="SplitMode" Content="Começar um novo arquivo nas páginas:"
                                     VerticalAlignment="Center" IsChecked="{Binding IsCutPoints, Mode=TwoWay}" />
                        <TextBox Width="260" Margin="8,0,0,0"
                                 Text="{Binding CutPointsText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsCutPoints}"
                                 ToolTip="Exemplo: 4,9 gera os arquivos 1-3, 4-8 e 9 até o fim" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton GroupName="SplitMode" Content="Por tamanho — no máximo" VerticalAlignment="Center"
                                     IsChecked="{Binding IsSize, Mode=TwoWay}" />
                        <TextBox Width="72" Margin="8,0,8,0"
                                 Text="{Binding SizeMbText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsSize}" />
                        <TextBlock Text="MB por arquivo" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    </StackPanel>

                    <RadioButton GroupName="SplitMode" Margin="0,6,0,0"
                                 Content="Por marcadores — um arquivo para cada marcador de primeiro nível"
                                 IsChecked="{Binding IsBookmarks, Mode=TwoWay}" IsEnabled="{Binding HasBookmarks}" />
                </StackPanel>
            </Border>

            <!-- Nomes e destino -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Nomes dos arquivos" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBox Width="360" HorizontalAlignment="Left"
                             Text="{Binding NamePattern, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,5,0,0"
                               Text="Campos: {nome} = nome do original · {n} = número do arquivo · {inicio} e {fim} = páginas · {total}. Use zeros para a largura: {n:000} gera 001, 002…" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}"
                                      Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Prévia e execução -->
            <DockPanel Margin="2,14,0,0">
                <Button DockPanel.Dock="Right" Content="Dividir" Style="{StaticResource PrimaryButton}" MinWidth="120"
                        VerticalAlignment="Top" Margin="16,0,0,0" Command="{Binding StartCommand}" />
                <Grid>
                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Body}"
                               Visibility="{Binding Problem, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Danger}"
                               Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />
                </Grid>
            </DockPanel>

            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
