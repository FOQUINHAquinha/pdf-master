<UserControl x:Class="PDFMaster.App.Views.PageEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>

    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

        <!-- Barra de ferramentas -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,14,0,0">
            <Button Content="Abrir PDF…" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,10,6"
                    Command="{Binding PickFileCommand}" />
            <Button Content="Inserir PDF…" Style="{StaticResource ToolbarButton}"
                    ToolTip="Insere as páginas de outro documento depois da seleção (ou no final)"
                    Command="{Binding InsertFromFileCommand}" />
            <Button Content="Página em branco" Style="{StaticResource ToolbarButton}" Margin="0,0,16,6"
                    ToolTip="Insere uma página em branco depois da seleção (ou no final)"
                    Command="{Binding InsertBlankCommand}" />
            <Button Content="Girar à esquerda" Style="{StaticResource ToolbarButton}"
                    ToolTip="Gira 90° as páginas selecionadas; sem seleção, todas"
                    Command="{Binding RotateLeftCommand}" />
            <Button Content="Girar à direita" Style="{StaticResource ToolbarButton}" Margin="0,0,16,6"
                    ToolTip="Gira 90° as páginas selecionadas; sem seleção, todas"
                    Command="{Binding RotateRightCommand}" />
            <Button Content="◀ Mover" Style="{StaticResource ToolbarButton}"
                    ToolTip="Move as páginas selecionadas uma posição para trás"
                    Command="{Binding MoveLeftCommand}" />
            <Button Content="Mover ▶" Style="{StaticResource ToolbarButton}" Margin="0,0,16,6"
                    ToolTip="Move as páginas selecionadas uma posição para frente"
                    Command="{Binding MoveRightCommand}" />
            <Button Content="Duplicar" Style="{StaticResource ToolbarButton}" Command="{Binding DuplicateCommand}" />
            <Button Content="Excluir" Style="{StaticResource ToolbarButton}" Margin="0,0,16,6"
                    ToolTip="Remove as páginas selecionadas do novo documento (tecla Delete)"
                    Command="{Binding DeleteCommand}" />
            <Button Content="Desfazer" Style="{StaticResource ToolbarButton}" ToolTip="Ctrl+Z"
                    Command="{Binding UndoCommand}" />
            <Button Content="Refazer" Style="{StaticResource ToolbarButton}" ToolTip="Ctrl+Y"
                    Command="{Binding RedoCommand}" />
        </WrapPanel>

        <!-- Seleção -->
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="Selecionar páginas:" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                <TextBox x:Name="RangeBox" Width="170" Margin="8,0,6,0"
                         Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Exemplos: 1-5 · 1,3,5,7 · 2-8,12,15-20 (Enter para aplicar)">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SelectRangeCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Selecionar" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0"
                        Command="{Binding SelectRangeCommand}" />
                <Button Content="Tudo" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0"
                        Command="{Binding SelectAllCommand}" />
                <Button Content="Nenhuma" Style="{StaticResource ToolbarButton}" Margin="0,0,12,0"
                        Command="{Binding ClearSelectionCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Secondary}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Rodapé: gravar -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Nome do novo arquivo" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A extensão .pdf é adicionada automaticamente" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}"
                                  ContentTemplate="{StaticResource ToolOutputFolder}" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Extrair selecionadas" Style="{StaticResource SecondaryButton}"
                            ToolTip="Grava um novo PDF só com as páginas selecionadas"
                            Command="{Binding ExtractCommand}" />
                    <Button Content="Salvar como novo PDF" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Body}" Margin="2,8,0,0" />

        <!-- Páginas -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="28"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste um PDF para cá ou use “Abrir PDF…”" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Depois, arraste as miniaturas para mudar a ordem."
                               Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectionMode="Extended"
                         Background="Transparent" BorderThickness="0" AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnPagesMouseDown" PreviewMouseMove="OnPagesMouseMove"
                         DragOver="OnPagesDragOver" Drop="OnPagesDrop" KeyDown="OnPagesKeyDown"
                         Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Margin="5" Padding="6" CornerRadius="8"
                                                Background="Transparent" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.Subtle}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.AccentSoft}" />
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="164" ToolTip="{Binding SourceLabel}">
                                <Grid Height="196">
                                    <Border Style="{StaticResource PageFrame}" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" MinWidth="60" MinHeight="80">
                                        <Border.LayoutTransform>
                                            <RotateTransform Angle="{Binding Rotation}" />
                                        </Border.LayoutTransform>
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="150"
                                                   MaxHeight="150" />
                                            <TextBlock Text="em branco" FontSize="11" Foreground="#8A8F8C"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="14,40"
                                                       Visibility="{Binding IsBlank, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Position}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Secondary}" FontSize="11"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
