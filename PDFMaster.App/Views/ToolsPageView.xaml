<UserControl x:Class="PDFMaster.App.Views.ToolsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Margin="0,4,0,0" FontSize="13.5" />

            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}"
                    Visibility="{Binding HasUnavailable, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="As ferramentas marcadas como “Prevista” ainda não foram implementadas e por isso não podem ser abertas. Cada uma é liberada somente depois de funcionar com arquivos reais e passar nos testes." />
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Tools}" Margin="-7,10,-7,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Width="288" MinHeight="148" Margin="7" Style="{StaticResource Card}"
                                Padding="16">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Border x:Name="Badge" DockPanel.Dock="Left" CornerRadius="10" Padding="9,3"
                                            Background="{DynamicResource Brush.Subtle}">
                                        <TextBlock x:Name="BadgeText" Text="{Binding StatusText}" FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Border>
                                    <TextBlock Text="{Binding CategoryName}" Style="{StaticResource Secondary}"
                                               FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.ShowCategory, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="8"
                                                Background="{DynamicResource Brush.AccentSoft}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17"
                                                       Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="204"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
