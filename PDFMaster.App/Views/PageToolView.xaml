<UserControl x:Class="PDFMaster.App.Views.PageToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adicionar PDFs…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
        </StackPanel>

        <!-- Opções -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0"
                Visibility="{Binding IsBlank, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <CheckBox Content="Remover também páginas repetidas (iguais a uma página anterior: mesmo tamanho, texto e imagem)"
                          IsChecked="{Binding AlsoDuplicates, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Uma página é considerada em branco quando não tem texto e quase nenhum pixel escuro (até 0,1% da área). Confira o resultado antes de descartar o original." />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0"
                Visibility="{Binding IsCrop, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Margens a recortar em todas as páginas (mm)" Style="{StaticResource Body}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Cima" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="60" Text="{Binding TopMm, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Baixo" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="60" Text="{Binding BottomMm, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Esquerda" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="60" Text="{Binding LeftMm, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Direita" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="60" Text="{Binding RightMm, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0"
                Visibility="{Binding IsNUp, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="2 páginas por folha" GroupName="NUp" IsChecked="{Binding TwoPerSheet, Mode=TwoWay}" />
                    <RadioButton Content="4 páginas por folha" GroupName="NUp" Margin="18,0,0,0" IsChecked="{Binding FourPerSheet, Mode=TwoWay}" />
                    <RadioButton Content="Livreto (dobrar ao meio)" GroupName="NUp" Margin="18,0,0,0" IsChecked="{Binding Booklet, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Folha" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox MinWidth="120" ItemsSource="{Binding Sheets}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="No livreto, as páginas são completadas com páginas em branco até um múltiplo de 4 e ficam na ordem de dobra: imprima frente e verso virando pela borda curta." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Style="{StaticResource PrimaryButton}" MinWidth="160"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding ApplyCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0" MaxHeight="160"
                Visibility="{Binding Result, Converter={StaticResource NullToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Result}" Style="{StaticResource Body}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <ContentPresenter Margin="0,12,0,0" Content="{Binding}" ContentTemplate="{StaticResource ToolFileList}" />
    </DockPanel>
</UserControl>
