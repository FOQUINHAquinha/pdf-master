<UserControl x:Class="PDFMaster.App.Views.BatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="StepFieldTemplate">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" Margin="0,0,0,3"
                           Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                <CheckBox Content="{Binding Label}" IsChecked="{Binding Flag, Mode=TwoWay}"
                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

        <DockPanel DockPanel.Dock="Top" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Adicionar arquivos…" Style="{StaticResource PrimaryButton}" Command="{Binding AddFilesPickCommand}" />
            <Button DockPanel.Dock="Left" Content="Adicionar pasta…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding AddFolderCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="Fluxo" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="22,0,8,0" />
            <ComboBox DockPanel.Dock="Left" MinWidth="320" ItemsSource="{Binding Flows}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedFlow, Mode=TwoWay}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Content="Editar fluxos" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Command="{Binding ToggleFlowEditorCommand}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedFlowDescription}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                   TextWrapping="Wrap" Visibility="{Binding SelectedFlowDescription, Converter={StaticResource NullToVis}}" />

        <!-- Editor de fluxos -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0" DataContext="{Binding Editor}"
                Visibility="{Binding DataContext.IsEditingFlows, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Salvar fluxos" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                    <Button DockPanel.Dock="Right" Content="Descartar alterações" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding DiscardCommand}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
                <Grid MaxHeight="330">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Margin="0,0,14,0">
                        <TextBlock DockPanel.Dock="Top" Text="Fluxos" Style="{StaticResource SectionTitle}" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Novo" Style="{StaticResource ToolbarButton}" Command="{Binding NewFlowCommand}" />
                            <Button Content="Duplicar" Style="{StaticResource ToolbarButton}" Command="{Binding DuplicateFlowCommand}" />
                            <Button Content="Excluir" Style="{StaticResource ToolbarButton}" Command="{Binding DeleteFlowCommand}" />
                        </WrapPanel>
                        <ListBox Margin="0,6,0,0" ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow, Mode=TwoWay}" DisplayMemberPath="Name" />
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="0,0,14,0" DataContext="{Binding SelectedFlow}"
                               Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Nome do fluxo" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sufixo do arquivo" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" ToolTip="Acrescentado ao nome: contrato_processado.pdf" />
                            </StackPanel>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="Etapas, na ordem em que são aplicadas" Style="{StaticResource Secondary}" Margin="0,10,0,3" />
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                   DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Border}}">
                            <Button DockPanel.Dock="Right" Content="Adicionar etapa" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding AddStepCommand}" />
                            <ComboBox ItemsSource="{Binding StepTypes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStepType, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Border}}">
                            <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Subir etapa" Command="{Binding MoveStepUpCommand}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Descer etapa" Command="{Binding MoveStepDownCommand}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remover etapa" Command="{Binding RemoveStepCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding SelectedFlow.Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Brush.Danger}" FontSize="12" TextWrapping="Wrap"
                                                       Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </DockPanel>

                    <DockPanel Grid.Column="2" DataContext="{Binding SelectedStep}" Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                        <TextBlock DockPanel.Dock="Top" Text="Esta etapa não tem opções." Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                   Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource StepFieldTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Destino e controles -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Iniciar" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="0,0,8,6" Command="{Binding StartCommand}" />
                    <Button Content="Pausar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding PauseCommand}"
                            ToolTip="Não começa tarefas novas; as em andamento param ao fim da etapa atual" />
                    <Button Content="Retomar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding ResumeCommand}" />
                    <Button Content="Cancelar tudo" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding CancelAllCommand}" />
                    <Button Content="Reprocessar somente com erro" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding RetryFailedCommand}" />
                    <Button Content="Limpar concluídas" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding ClearFinishedCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding ParallelText}" Style="{StaticResource Secondary}" />
            </StackPanel>
        </Border>

        <!-- Fila -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste para cá arquivos ou pastas (PDF, imagens, texto, HTML ou Office)" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Cada arquivo entra na fila com o fluxo escolhido acima." Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <DockPanel Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,2,0,8" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Arquivo" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Operação" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Estado" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Progresso" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Original" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Final" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="6" Text="Destino" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="7" Text="Tempo" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Jobs}" Template="{StaticResource ScrollingItems}" ItemsPanel="{StaticResource VirtualPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="128" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"
                                                           Foreground="{DynamicResource Brush.Text}" />
                                                <TextBlock Text="{Binding Origin}" Style="{StaticResource Secondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Operation}" Style="{StaticResource Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Operation}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" x:Name="State" Text="{Binding StateText}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                <TextBlock Text="{Binding StepText}" Style="{StaticResource Secondary}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding StepText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding OriginalSize}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding FinalSize}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding Destination}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Destination}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="7" Text="{Binding ElapsedText}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Abrir o resultado" Command="{Binding OpenCommand}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Repetir tarefa" Command="{Binding RetryCommand}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Cancelar tarefa" Command="{Binding CancelCommand}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remover da fila (nenhum arquivo é apagado)"
                                                        Command="{Binding RemoveCommand}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding NotesText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding NotesText, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
