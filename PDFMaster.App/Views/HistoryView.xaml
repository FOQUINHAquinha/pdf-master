<UserControl x:Class="PDFMaster.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,24,28,24">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Limpar histórico" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Center" Command="{Binding ClearAllCommand}" />
            <StackPanel>
                <TextBlock Text="Histórico" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" FontSize="13.5"
                           Text="Operações executadas neste computador. O conteúdo dos documentos nunca é armazenado." />
            </StackPanel>
        </DockPanel>

        <!-- Filtros -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,12">
            <WrapPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Pesquisar" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Tipo de operação" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <ComboBox Width="200" ItemsSource="{Binding Operations}"
                              SelectedItem="{Binding SelectedOperation, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="De" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <DatePicker Width="150" SelectedDate="{Binding FromDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Até" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <DatePicker Width="150" SelectedDate="{Binding ToDate, Mode=TwoWay}" />
                </StackPanel>
                <Button Content="Limpar filtros" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"
                        Margin="0,0,0,4" Command="{Binding ClearFiltersCommand}" />
            </WrapPanel>
        </Border>

        <!-- Registros -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,10">
            <Grid>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Secondary}" FontSize="13.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                           Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <DockPanel Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="156" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Data" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Arquivo" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Operação" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Duração" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Resultado" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Records}" Template="{StaticResource ScrollingItems}"
                                  ItemsPanel="{StaticResource VirtualPanel}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                                        Padding="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="156" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource Secondary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" ToolTip="{Binding FileName}"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Operation}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Grid.Column="4" Text="{Binding DurationText}"
                                                   Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding Result}"
                                                   Style="{StaticResource Secondary}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" ToolTip="{Binding Result}" />
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                                    ToolTip="{Binding RepeatTooltip}" ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding RepeatCommand}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8E5;"
                                                    ToolTip="Abrir arquivo resultante"
                                                    Command="{Binding OpenFileCommand}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                                    ToolTip="Abrir pasta de destino"
                                                    Command="{Binding OpenFolderCommand}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                    ToolTip="Excluir este registro (o arquivo não é apagado)"
                                                    Command="{Binding DeleteCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
