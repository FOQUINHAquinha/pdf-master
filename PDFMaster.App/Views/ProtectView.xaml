<UserControl x:Class="PDFMaster.App.Views.ProtectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adicionar PDFs…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Proteger" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding StartCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap" Margin="2,10,0,0"
                   Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox Content="Exigir senha para abrir o documento" IsChecked="{Binding RequireOpenPassword, Mode=TwoWay}" Margin="0" />
                    <Grid IsEnabled="{Binding RequireOpenPassword}" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Senha de abertura" Style="{StaticResource Label}" />
                            <PasswordBox Tag="user" PasswordChanged="OnPasswordChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Confirmar" Style="{StaticResource Label}" />
                            <PasswordBox Tag="userConfirm" PasswordChanged="OnPasswordChanged" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Senha de proprietário" Style="{StaticResource Label}" />
                            <PasswordBox Tag="owner" PasswordChanged="OnPasswordChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Confirmar" Style="{StaticResource Label}" />
                            <PasswordBox Tag="ownerConfirm" PasswordChanged="OnPasswordChanged" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0"
                               Text="Criptografia AES de 256 bits. A senha de proprietário libera as restrições e permite remover a proteção. As senhas ficam só na memória enquanto a tela está aberta: o programa não as grava. Sem a senha de abertura, ninguém consegue abrir o documento — guarde-a." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Quem abrir sem a senha de proprietário pode:" Style="{StaticResource Label}" Margin="0,0,0,3" />
                    <CheckBox Content="Imprimir" IsChecked="{Binding AllowPrint, Mode=TwoWay}" />
                    <CheckBox Content="Imprimir em alta qualidade" Margin="22,4,0,0" IsChecked="{Binding AllowHighQualityPrint, Mode=TwoWay}" IsEnabled="{Binding AllowPrint}" />
                    <CheckBox Content="Copiar texto e imagens" IsChecked="{Binding AllowCopy, Mode=TwoWay}" />
                    <CheckBox Content="Alterar o documento" IsChecked="{Binding AllowModify, Mode=TwoWay}" />
                    <CheckBox Content="Comentar (anotações)" IsChecked="{Binding AllowAnnotate, Mode=TwoWay}" />
                    <CheckBox Content="Preencher formulários" IsChecked="{Binding AllowForms, Mode=TwoWay}" />
                    <CheckBox Content="Montar (inserir, girar e excluir páginas)" IsChecked="{Binding AllowAssemble, Mode=TwoWay}" />
                    <CheckBox Content="Extrair texto para acessibilidade (leitores de tela)" IsChecked="{Binding AllowAccessibility, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0"
                               Text="As restrições dependem do programa leitor respeitá-las; para sigilo de verdade, use a senha de abertura." />
                </StackPanel>
            </Grid>
        </Border>

        <ContentPresenter Margin="0,12,0,0" Content="{Binding}" ContentTemplate="{StaticResource ToolFileList}" />
    </DockPanel>
</UserControl>
