<UserControl x:Class="PDFMaster.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Abrir PDF…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Remover proteção" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding StartCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                Visibility="{Binding Summary, Converter={StaticResource NullToVis}}">
            <StackPanel>
                <TextBlock Text="Situação do documento" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                <StackPanel Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                    <TextBlock Text="Senha de proprietário (ou a senha que dá todas as permissões)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                    <PasswordBox Width="320" HorizontalAlignment="Left" PasswordChanged="OnPasswordChanged" />
                    <CheckBox Margin="0,10,0,0" IsChecked="{Binding Authorized, Mode=TwoWay}">
                        <TextBlock TextWrapping="Wrap" Text="Confirmo que tenho autorização para remover a proteção deste documento." />
                    </CheckBox>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0"
                               Text="A senha é usada só para esta operação e não é gravada. O programa não tenta adivinhar senhas." />
                </StackPanel>
            </StackPanel>
        </Border>

        <ContentPresenter Margin="0,12,0,0" Content="{Binding}" ContentTemplate="{StaticResource ToolFileList}" />
    </DockPanel>
</UserControl>
