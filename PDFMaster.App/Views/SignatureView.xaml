<UserControl x:Class="PDFMaster.App.Views.SignatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Abrir PDF…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
            <Button Content="Verificar de novo" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding VerifyAgainCommand}" />
            <Button Content="Pasta de raízes confiáveis…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding OpenRootsFolderCommand}" />
        </StackPanel>
        <ContentPresenter DockPanel.Dock="Top" Margin="0,12,0,0" MaxHeight="110" Content="{Binding}" ContentTemplate="{StaticResource ToolFileList}" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Salvar relatório" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding SaveReportCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding RootsInfo}" Style="{StaticResource Secondary}" Margin="2,10,0,0" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Body}" Margin="2,12,0,0"
                   Visibility="{Binding Summary, Converter={StaticResource NullToVis}}" />

        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Signatures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,4,0,4">
                            <DockPanel>
                                <Border x:Name="Bar" DockPanel.Dock="Left" Width="5" CornerRadius="2" Margin="0,0,14,0" Background="{DynamicResource Brush.Warning}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="Verdict" Text="{Binding Verdict}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,6"
                                               Foreground="{DynamicResource Brush.Warning}" />
                                    <ItemsControl ItemsSource="{Binding Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,1,0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="good">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Verdict" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="bad">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Danger}" />
                                <Setter TargetName="Verdict" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
