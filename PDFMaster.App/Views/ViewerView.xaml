<UserControl x:Class="PDFMaster.App.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="Home" Modifiers="Control" Command="{Binding FirstPageCommand}" />
        <KeyBinding Key="End" Modifiers="Control" Command="{Binding LastPageCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ActualSizeCommand}" />
    </UserControl.InputBindings>

    <DockPanel Margin="28,22,28,22">
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding DocumentName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding DocumentDetails}" Style="{StaticResource Secondary}"
                           HorizontalAlignment="Right" />
            </StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        </DockPanel>

        <!-- Barra de ferramentas -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,14,0,2">
            <Button Content="Abrir PDF…" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,14,6"
                    Command="{Binding PickFileCommand}" />

            <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="12" Margin="0,0,0,6"
                    ToolTip="Primeira página (Ctrl+Home)" Command="{Binding FirstPageCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Margin="0,0,0,6"
                    ToolTip="Página anterior (Page Up)" Command="{Binding PreviousPageCommand}" />
            <TextBox Width="56" Margin="4,0,6,6" HorizontalContentAlignment="Center"
                     Text="{Binding PageNumberText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Digite o número da página e pressione Enter">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding GoToPageCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="{Binding PageCountText}" Style="{StaticResource Body}" VerticalAlignment="Center"
                       Margin="0,0,4,6" />
            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Margin="0,0,0,6"
                    ToolTip="Próxima página (Page Down)" Command="{Binding NextPageCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="12" Margin="0,0,14,6"
                    ToolTip="Última página (Ctrl+End)" Command="{Binding LastPageCommand}" />

            <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Margin="0,0,0,6"
                    ToolTip="Diminuir zoom (Ctrl −)" Command="{Binding ZoomOutCommand}" />
            <TextBlock Text="{Binding ZoomText}" Style="{StaticResource Body}" Width="48" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="0,0,0,6" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Margin="0,0,6,6"
                    ToolTip="Aumentar zoom (Ctrl +)" Command="{Binding ZoomInCommand}" />
            <Button Content="100%" Style="{StaticResource ToolbarButton}" ToolTip="Tamanho real (Ctrl+0)"
                    Command="{Binding ActualSizeCommand}" />
            <Button Content="Ajustar à largura" Style="{StaticResource ToolbarButton}" Margin="0,0,14,6"
                    Command="{Binding FitWidthCommand}" />

            <Button Content="Editar" Style="{StaticResource ToolbarButton}"
                    ToolTip="Abre este documento no editor (texto, imagens, anotações, assinaturas)" Command="{Binding EditCommand}" />
            <Button Content="Organizar páginas" Style="{StaticResource ToolbarButton}"
                    ToolTip="Abre este documento no editor de páginas" Command="{Binding OrganizeCommand}" />
            <Button Content="Dividir" Style="{StaticResource ToolbarButton}"
                    ToolTip="Abre este documento na ferramenta Dividir PDF" Command="{Binding SplitCommand}" />
        </WrapPanel>

        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Miniaturas -->
            <Border Style="{StaticResource Card}" Padding="4">
                <ListBox x:Name="ThumbList" ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}" Background="Transparent"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnThumbSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Margin="3" Padding="6" CornerRadius="8"
                                                Background="Transparent" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.Subtle}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.AccentSoft}" />
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="140">
                                <Border Style="{StaticResource PageFrame}" HorizontalAlignment="Center" MinWidth="60"
                                        MinHeight="80">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="128"
                                           MaxHeight="170" />
                                </Border>
                                <TextBlock Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Página -->
            <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource Brush.Subtle}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="30"
                                   Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="Arraste um PDF para cá ou use “Abrir PDF…”" Style="{StaticResource Body}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding RenderError}" FontSize="13" TextWrapping="Wrap" Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Danger}"
                               Visibility="{Binding RenderError, Converter={StaticResource NullToVis}}" />

                    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" Focusable="False"
                                  SizeChanged="OnViewportSizeChanged" PreviewMouseWheel="OnPageMouseWheel"
                                  Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                        <Border Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Image Source="{Binding PageImage}" Stretch="None" SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
