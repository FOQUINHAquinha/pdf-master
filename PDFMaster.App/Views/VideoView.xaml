<UserControl x:Class="PDFMaster.App.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adicionar vídeos…" Style="{StaticResource PrimaryButton}"
                    Command="{Binding PickFilesCommand}" />
            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Command="{Binding ClearCommand}" />
        </StackPanel>

        <!-- Rodapé: destino e execução -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Comprimir vídeos" Style="{StaticResource PrimaryButton}"
                        MinWidth="150" VerticalAlignment="Bottom" Margin="16,0,0,0"
                        Command="{Binding StartCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />

        <TextBlock DockPanel.Dock="Bottom" Margin="2,10,0,0" Text="{Binding Summary}" Style="{StaticResource Body}"
                   TextWrapping="Wrap" />

        <!-- Resultado e mecanismo -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Resultado" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                           Text="MP4 (vídeo H.264 e áudio AAC) em 360p: o lado menor da imagem fica com 360 pixels e a proporção é mantida — 640×360 num vídeo deitado, 360×640 num vídeo de celular em pé. No máximo 30 quadros por segundo e áudio estéreo." />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Vídeos menores que 360p não são ampliados. Legendas e capítulos não são levados. Vídeos HDR podem ficar com as cores mais apagadas. O original nunca é alterado." />

                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="Localizar ffmpeg.exe…" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                    Command="{Binding LocateFfmpegCommand}"
                                    ToolTip="Use outro FFmpeg instalado no computador. Nada é baixado pelo programa." />
                            <Button Content="Usar o FFmpeg incluído" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                    Margin="8,0,0,0" Command="{Binding UseBundledFfmpegCommand}"
                                    Visibility="{Binding UsesCustomEngine, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding EngineText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EngineProblem}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       Visibility="{Binding EngineProblem, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Lista de vídeos -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,8" MinHeight="90">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="26"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste para cá os vídeos (ou uma pasta com vídeos)" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="MP4, MOV, AVI, MKV, WEBM, WMV, FLV, MPG, 3GP e outros. Vários vídeos são processados em fila."
                               Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Files}" Template="{StaticResource ScrollingItems}"
                              ItemsPanel="{StaticResource VirtualPanel}"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12"
                                                ToolTip="Mover para cima" Command="{Binding MoveUpCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12"
                                                ToolTip="Mover para baixo" Command="{Binding MoveDownCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                                                ToolTip="Remover da lista (o arquivo não é apagado)"
                                                Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE714;" Style="{StaticResource Icon}"
                                               FontSize="18" Margin="0,0,12,0"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusLine" Text="{Binding Status}" FontSize="12"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}"
                                                   Visibility="{Binding Status, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                    <Setter TargetName="StatusLine" Property="Foreground"
                                            Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
