<UserControl x:Class="PDFMaster.App.Views.HeaderFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adicionar PDFs…" Style="{StaticResource PrimaryButton}" Command="{Binding PickFilesCommand}" />
            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Aplicar" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding StartCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap" Margin="2,10,0,0"
                   Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="Esquerda" Style="{StaticResource Secondary}" />
                    <TextBlock Grid.Column="3" Text="Centro" Style="{StaticResource Secondary}" />
                    <TextBlock Grid.Column="5" Text="Direita" Style="{StaticResource Secondary}" />
                    <TextBlock Grid.Row="1" Text="Cabeçalho" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding HeaderLeft, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" Text="{Binding HeaderCenter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="5" Margin="0,4,0,0" Text="{Binding HeaderRight, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="Rodapé" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Text="{Binding FooterLeft, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="0,4,0,0" Text="{Binding FooterCenter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="2" Grid.Column="5" Margin="0,4,0,0" Text="{Binding FooterRight, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Campos: {arquivo} nome do documento · {data} · {hora} · {pagina} número da página · {total} total de páginas. Exemplo: Página {pagina} de {total}." />
                <WrapPanel Margin="0,4,0,0">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Fonte" Style="{StaticResource Label}" />
                        <ComboBox Width="150" ItemsSource="{Binding Families}" SelectedItem="{Binding FontFamily, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Tamanho" Style="{StaticResource Label}" />
                        <TextBox Width="56" Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Cor" Style="{StaticResource Label}" />
                        <TextBox Width="84" Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Margem sup./inf. (mm)" Style="{StaticResource Label}" />
                        <TextBox Width="70" Text="{Binding EdgeMarginText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Margem lateral (mm)" Style="{StaticResource Label}" />
                        <TextBox Width="70" Text="{Binding SideMarginText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Páginas (vazio = todas)" Style="{StaticResource Label}" />
                        <TextBox Width="120" Text="{Binding Pages, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Primeiro número" Style="{StaticResource Label}" />
                        <TextBox Width="60" Text="{Binding FirstNumberText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding Preview, StringFormat='Exemplo: {0}'}" Style="{StaticResource Secondary}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Lista de documentos -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,8" MinHeight="90">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste para cá os PDFs" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Vários documentos são processados em fila. Os originais não são alterados."
                               Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Files}" Template="{StaticResource ScrollingItems}" ItemsPanel="{StaticResource VirtualPanel}"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12" ToolTip="Mover para cima" Command="{Binding MoveUpCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12" ToolTip="Mover para baixo" Command="{Binding MoveDownCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Remover da lista (o arquivo não é apagado)" Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusLine" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}"
                                                   Visibility="{Binding Status, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
