<UserControl x:Class="PDFMaster.App.Views.WatchFolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

        <DockPanel DockPanel.Dock="Top" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Nova pasta monitorada…" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" />
            <Button DockPanel.Dock="Left" Content="Pausar monitoramento" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding PauseCommand}" />
            <Button DockPanel.Dock="Left" Content="Retomar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ResumeCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding ServiceText}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <!-- Cadastro / edição -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Pasta monitorada" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nome" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Pasta de entrada (monitorada)" Style="{StaticResource Secondary}" Margin="0,10,0,3" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding BrowseInputCommand}" />
                            <TextBox Text="{Binding EditInput, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="Pasta de saída (resultados)" Style="{StaticResource Secondary}" Margin="0,10,0,3" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                            <TextBox Text="{Binding EditOutput, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fluxo aplicado a cada arquivo (crie e edite em Fila de tarefas)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding FlowNames}" SelectedItem="{Binding EditFlow, Mode=TwoWay}" />
                        <CheckBox Content="Incluir subpastas" Margin="0,12,0,0" IsChecked="{Binding EditSubfolders, Mode=TwoWay}" />
                        <CheckBox Content="Processar também os arquivos que já estão na pasta" Margin="0,8,0,0" IsChecked="{Binding EditProcessExisting, Mode=TwoWay}" />
                        <CheckBox Content="Ativa" Margin="0,8,0,0" IsChecked="{Binding EditEnabled, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Cada arquivo é processado uma vez e só depois de terminar de ser copiado. Os originais permanecem na pasta de entrada." />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding EditProblem}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding EditProblem, Converter={StaticResource NullToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}" />
                    <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="100" Command="{Binding SaveFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Atividade -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,10" Margin="0,12,0,0" Height="170">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Atividade recente" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="Nenhuma atividade desde que o programa foi aberto." Style="{StaticResource Secondary}"
                               Visibility="{Binding Log.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Log}" Template="{StaticResource ScrollingItems}" ItemsPanel="{StaticResource VirtualPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Pastas -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFolders, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Nenhuma pasta monitorada" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Clique em &quot;Nova pasta monitorada&quot; ou arraste uma pasta para cá." Style="{StaticResource Secondary}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Folders}" Template="{StaticResource ScrollingItems}"
                              Visibility="{Binding HasFolders, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Ativar / desativar" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Editar" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Abrir a pasta de saída"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Excluir (nenhum arquivo é apagado)"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Route}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Route}" />
                                        <TextBlock Text="{Binding FlowText}" Style="{StaticResource Secondary}" />
                                        <TextBlock x:Name="State" Text="{Binding StateText}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Counters}" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
