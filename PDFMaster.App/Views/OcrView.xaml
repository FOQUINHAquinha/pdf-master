<UserControl x:Class="PDFMaster.App.Views.OcrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22,28,22">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adicionar documentos…" Style="{StaticResource PrimaryButton}"
                    Command="{Binding PickFilesCommand}" />
            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Command="{Binding ClearCommand}" />
        </StackPanel>

        <!-- Rodapé: destino e execução -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reconhecer texto" Style="{StaticResource PrimaryButton}"
                        MinWidth="150" VerticalAlignment="Bottom" Margin="16,0,0,0"
                        Command="{Binding StartCommand}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolOutputFolder}" />
            </DockPanel>
        </Border>
        <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ToolBusy}" />

        <Grid DockPanel.Dock="Bottom" Margin="2,10,0,0">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Danger}"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />
        </Grid>

        <!-- Opções -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Idiomas do documento" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Languages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,0,18,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Instalar idioma…" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                    Command="{Binding InstallLanguageCommand}"
                                    ToolTip="Escolha um arquivo .traineddata do Tesseract. Nada é baixado pelo programa." />
                            <Button Content="Abrir pasta dos modelos" Style="{StaticResource SecondaryButton}"
                                    Padding="10,5" Margin="8,0,0,0" Command="{Binding OpenModelsFolderCommand}" />
                        </StackPanel>

                        <TextBlock Text="Resultado" Style="{StaticResource Secondary}" Margin="0,14,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="PDF pesquisável" IsChecked="{Binding SearchablePdf, Mode=TwoWay}" />
                            <CheckBox Content="Texto (TXT)" Margin="18,0,0,0" IsChecked="{Binding TextFile, Mode=TwoWay}" />
                            <CheckBox Content="Word (DOCX)" Margin="18,0,0,0" IsChecked="{Binding Docx, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Resolução (DPI)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                                <TextBox Width="90" Text="{Binding DpiText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="300 é o recomendado. Valores menores são mais rápidos; maiores ajudam com letras pequenas." />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Páginas (vazio = todas)" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                                <TextBox Width="170" Text="{Binding PagesText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Exemplos: 1-5 · 1,3,5,7 · 2-8,12,15-20" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Content="Corrigir a orientação das páginas (deitadas ou de cabeça para baixo)"
                                  Margin="0,10,0,0" IsChecked="{Binding AutoRotate, Mode=TwoWay}" />
                        <CheckBox Content="Corrigir inclinação antes de reconhecer" Margin="0,4,0,0"
                                  IsChecked="{Binding Deskew, Mode=TwoWay}" />
                        <CheckBox Content="Melhorar o contraste" Margin="0,4,0,0"
                                  IsChecked="{Binding EnhanceContrast, Mode=TwoWay}" />
                        <CheckBox Content="Remover ruído (pontos isolados; mais lento)" Margin="0,4,0,0"
                                  IsChecked="{Binding Denoise, Mode=TwoWay}" />
                        <CheckBox Content="Pular páginas que já têm texto pesquisável" Margin="0,4,0,0"
                                  IsChecked="{Binding SkipPagesWithText, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0"
                           Text="No PDF pesquisável a página original é mantida e recebe uma camada de texto invisível. Contraste, ruído e inclinação são ajustados só na imagem usada para reconhecer; a aparência da página não muda. O reconhecimento não é perfeito: confira nomes, números e valores antes de usar o texto. Manuscritos não são reconhecidos." />
            </StackPanel>
        </Border>

        <!-- Lista de documentos -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,8" MinHeight="90">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="26"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste para cá os PDFs digitalizados ou as imagens" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Vários documentos são processados em fila. Os originais não são alterados."
                               Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Files}" Template="{StaticResource ScrollingItems}"
                              ItemsPanel="{StaticResource VirtualPanel}"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12"
                                                ToolTip="Mover para cima" Command="{Binding MoveUpCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12"
                                                ToolTip="Mover para baixo" Command="{Binding MoveDownCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                                                ToolTip="Remover da lista (o arquivo não é apagado)"
                                                Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource Icon}"
                                               FontSize="18" Margin="0,0,12,0"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusLine" Text="{Binding Status}" FontSize="12"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}"
                                                   Visibility="{Binding Status, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                    <Setter TargetName="StatusLine" Property="Foreground"
                                            Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
