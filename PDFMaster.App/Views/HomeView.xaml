<UserControl x:Class="PDFMaster.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,28,28" MaxWidth="1180">

            <!-- Boas-vindas -->
            <TextBlock Text="Bem-vindo ao PDF Master" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" FontSize="13.5"
                       Text="Seu centro de ferramentas para documentos. Tudo é processado neste computador." />

            <!-- Área de arrastar e soltar -->
            <Grid Margin="0,18,0,0" MinHeight="132">
                <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="5 4"
                           Stroke="{DynamicResource Brush.Accent}" Fill="{DynamicResource Brush.AccentSoft}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="26"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Arraste arquivos ou pastas para cá" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="PDF, imagens, Word, Excel, PowerPoint, TXT e HTML"
                               Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Abrir arquivos" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddFilesCommand}" />
                        <Button Content="Importar pasta" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Progresso -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                            Margin="14,0,0,0" Command="{Binding CancelCommand}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="5" Margin="0,7,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Arquivos abertos -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copiar para pasta…" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ExportCommand}"
                                    ToolTip="Copia os arquivos válidos para uma pasta, sem alterar os originais" />
                            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding ClearFilesCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Arquivos abertos" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FilesSummary}" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,12,0,0" MaxHeight="330"
                                  Template="{StaticResource ScrollingItems}"
                                  ItemsPanel="{StaticResource VirtualPanel}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                                        Padding="2,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.Text}" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.Warning}"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding KindText}"
                                                   Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                                   Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8E5;"
                                                    ToolTip="Abrir no aplicativo padrão do Windows"
                                                    Command="{Binding OpenCommand}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                                    ToolTip="Mostrar na pasta" Command="{Binding RevealCommand}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                                                    FontSize="12" ToolTip="Remover da lista (o arquivo não é apagado)"
                                                    Command="{Binding RemoveCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recentes e últimas operações -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Limpar" Padding="10,4"
                                    Style="{StaticResource SecondaryButton}" Command="{Binding ClearRecentCommand}"
                                    Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Arquivos recentes" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0"
                                   Text="Nenhum arquivo recente. Os arquivos que você abrir aparecem aqui."
                                   Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding RecentFiles}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Content="&#xE711;" FontSize="11" Width="28" Height="28"
                                                ToolTip="Remover dos recentes" Command="{Binding RemoveCommand}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Content="&#xE710;" Width="28" Height="28" FontSize="13"
                                                ToolTip="Adicionar à lista de arquivos abertos"
                                                Command="{Binding AddCommand}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.Text}" />
                                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding WhenText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Folder, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Últimas operações" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0"
                                   Text="Nenhuma operação registrada ainda."
                                   Visibility="{Binding HasLastOperations, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding LastOperations}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Content="&#xE8B7;" Width="28" Height="28"
                                                ToolTip="Abrir pasta de destino" Command="{Binding OpenFolderCommand}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.Text}">
                                                <Run Text="{Binding Operation, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding FileName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding WhenText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                   Text="O histórico está desativado nas Configurações."
                                   Visibility="{Binding HistoryEnabled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource Secondary}" Margin="2,14,0,0"
                       Text="As seções “Ferramentas mais utilizadas” e “Ferramentas recomendadas” passam a aparecer aqui quando as primeiras ferramentas de PDF forem liberadas (Fase 2)." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
