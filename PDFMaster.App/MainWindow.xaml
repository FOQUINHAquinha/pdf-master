<Window x:Class="PDFMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PDFMaster.App.ViewModels"
        xmlns:views="clr-namespace:PDFMaster.App.Views"
        Title="PDF Master" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
            <views:ToolsPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CombineViewModel}">
            <views:CombineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OcrViewModel}">
            <views:OcrView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WatermarkViewModel}">
            <views:WatermarkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HeaderFooterViewModel}">
            <views:HeaderFooterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FormFillViewModel}">
            <views:FormFillView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoViewModel}">
            <views:VideoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConvertViewModel}">
            <views:ConvertView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompressViewModel}">
            <views:CompressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SplitViewModel}">
            <views:SplitView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageEditorViewModel}">
            <views:PageEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ViewerViewModel}">
            <views:ViewerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Uma notificação (usada no painel e no aviso flutuante) -->
        <DataTemplate x:Key="NotificationTemplate">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Margin="0,2,10,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource Brush.Accent}" />
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Secondary}"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Secondary}" Margin="0,3,0,0" />
                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding Command}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Window}" TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Barra superior ===== -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="PDF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}" />
                    </Border>
                    <TextBlock Text="PDF Master" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>

                <!-- Pesquisa de ferramentas -->
                <Grid Grid.Column="1" MaxWidth="520" Height="34" HorizontalAlignment="Stretch" Margin="12,0">
                    <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="17" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Left"
                               Margin="13,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                               IsHitTestVisible="False" />
                    <TextBlock Text="Pesquisar ferramentas — ex.: juntar documentos" Margin="38,0,38,0"
                               VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="34,0,34,0" VerticalContentAlignment="Center" FontSize="13"
                             Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}"
                             ToolTip="Pesquisar ferramentas (Ctrl+F)">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                                              VerticalAlignment="Center" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" FontSize="11"
                            HorizontalAlignment="Right" Margin="0,0,5,0" ToolTip="Limpar pesquisa"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText, Converter={StaticResource NullToVis}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Secondary}" VerticalAlignment="Center"
                               Margin="0,0,12,0" ToolTip="Versão instalada" />
                    <Button Style="{StaticResource IconButton}" Content="{Binding ThemeGlyph}"
                            ToolTip="{Binding ThemeTooltip}" Command="{Binding ToggleThemeCommand}" />
                    <Grid>
                        <ToggleButton x:Name="BellButton" Style="{StaticResource IconButton}" Content="&#xEA8F;"
                                      ToolTip="Notificações"
                                      IsChecked="{Binding Notifications.IsPanelOpen, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding Notifications.IsPanelOpen, Converter={StaticResource InverseBool}}" />
                        <Border MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,1,0,0" IsHitTestVisible="False"
                                Background="{DynamicResource Brush.Danger}"
                                Visibility="{Binding Notifications.UnreadCount, Converter={StaticResource CountToVis}}">
                            <TextBlock Text="{Binding Notifications.UnreadCount}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Panel}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Popup IsOpen="{Binding Notifications.IsPanelOpen, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
                               HorizontalOffset="-330" VerticalOffset="6" AllowsTransparency="True">
                            <Border Width="372" MaxHeight="460" Margin="6" Padding="14" CornerRadius="8"
                                    Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    TextElement.Foreground="{DynamicResource Brush.Text}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Limpar" Padding="10,4"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Notifications.ClearCommand}"
                                                Visibility="{Binding Notifications.HasItems, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="Notificações" Style="{StaticResource SectionTitle}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Nenhuma notificação."
                                               Style="{StaticResource Secondary}"
                                               Visibility="{Binding Notifications.HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Notifications.Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Brush.Border}"
                                                            BorderThickness="0,0,0,1" Padding="0,8">
                                                        <ContentPresenter Content="{Binding}"
                                                                          ContentTemplate="{StaticResource NotificationTemplate}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Configurações"
                            Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Menu lateral ===== -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,10,16,16">
                    <TextBlock FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.SidebarTextMuted}"
                               Text="Processamento 100% local. Sem conta, sem anúncios, sem envio de arquivos." />
                    <TextBlock x:Name="AuthorCredit" Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.SidebarTextMuted}"
                               Text="{Binding AuthorText}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                         PreviewMouseLeftButtonUp="OnNavClick">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="10,2"
                                                Padding="12,9">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.SidebarHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.SidebarSelected}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="13.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Área principal ===== -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- ===== Aviso flutuante ===== -->
        <Border Grid.Row="1" Grid.Column="1" Width="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Padding="14" CornerRadius="8" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                Visibility="{Binding Notifications.Toast, Converter={StaticResource NullToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Width="24"
                        Height="24" FontSize="10" VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="Fechar"
                        Command="{Binding Notifications.DismissToastCommand}" />
                <ContentPresenter Content="{Binding Notifications.Toast}"
                                  ContentTemplate="{StaticResource NotificationTemplate}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
